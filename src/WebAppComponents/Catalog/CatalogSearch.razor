@inject CatalogService CatalogService
@inject NavigationManager Nav

@if (catalogBrands is not null && catalogItemTypes is not null)
{
    <div class="mx-auto mb-8 max-w-7xl rounded-2xl border border-slate-200 bg-slate-50 p-5 shadow-sm">
        <div class="mb-5 flex items-center gap-2 text-lg font-semibold text-slate-900">
            <img role="presentation" src="icons/filters.svg" class="h-5 w-5" />
            Filters
        </div>

        <div class="space-y-6">
            <div>
                <h3 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500">Brand</h3>
                <div class="flex flex-wrap gap-2">
                    <a href="@BrandUri(null)"
                       class="rounded-full border px-3 py-1.5 text-sm font-medium transition @(BrandId == null ? "border-slate-900 bg-slate-900 text-white" : "border-slate-200 bg-white text-slate-700 hover:border-slate-900 hover:text-slate-900")">
                        All
                    </a>
                    @foreach (var brand in catalogBrands)
                    {
                        <a href="@BrandUri(brand.Id)"
                           class="rounded-full border px-3 py-1.5 text-sm font-medium transition @(BrandId == brand.Id ? "border-slate-900 bg-slate-900 text-white" : "border-slate-200 bg-white text-slate-700 hover:border-slate-900 hover:text-slate-900")">
                            @brand.Brand
                        </a>
                    }
                </div>
            </div>

            <div>
                <h3 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500">Type</h3>
                <div class="flex flex-wrap gap-2">
                    <a href="@TypeUri(null)"
                       class="rounded-full border px-3 py-1.5 text-sm font-medium transition @(ItemTypeId == null ? "border-slate-900 bg-slate-900 text-white" : "border-slate-200 bg-white text-slate-700 hover:border-slate-900 hover:text-slate-900")">
                        All
                    </a>
                    @foreach (var itemType in catalogItemTypes)
                    {
                        <a href="@TypeUri(itemType.Id)"
                           class="rounded-full border px-3 py-1.5 text-sm font-medium transition @(ItemTypeId == itemType.Id ? "border-slate-900 bg-slate-900 text-white" : "border-slate-200 bg-white text-slate-700 hover:border-slate-900 hover:text-slate-900")">
                            @itemType.Type
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    IEnumerable<CatalogBrand>? catalogBrands;
    IEnumerable<CatalogItemType>? catalogItemTypes;
    [Parameter] public int? BrandId { get; set; }
    [Parameter] public int? ItemTypeId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var brandsTask = CatalogService.GetBrands();
        var itemTypesTask = CatalogService.GetTypes();
        await Task.WhenAll(brandsTask, itemTypesTask);
        catalogBrands = brandsTask.Result;
        catalogItemTypes = itemTypesTask.Result;
    }

    private string BrandUri(int? brandId) => Nav.GetUriWithQueryParameters(new Dictionary<string, object?>()
    {
        { "page", null },
        { "brand", brandId },
    });

    private string TypeUri(int? typeId) => Nav.GetUriWithQueryParameters(new Dictionary<string, object?>()
    {
        { "page", null },
        { "type", typeId },
    });
}
